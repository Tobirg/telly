<?xml version="1.0" encoding="utf-8"?>
<!-- Fill of the segmented switch buttons: selected = paper, otherwise tonal; focus lightens. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/paper" android:state_checked="true" />
    <item android:color="@color/tonal_focus" android:state_focused="true" />
    <item android:color="@color/surface_alt" />
</selector>

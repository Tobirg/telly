<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Forced true-black Material theme, independent of system light/dark - this is for an OLED TV. -->
    <style name="Theme.Telly" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/paper</item>
        <item name="colorPrimaryDark">@color/black</item>
        <item name="colorSecondary">@color/paper</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/black</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="alertDialogTheme">@style/TellyDialog</item>
    </style>


    <!-- One button family (like Magisk): tonal pill, no outline; TV focus = lighter fill. -->
    <style name="TellyButton" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="backgroundTint">@color/tint_tonal</item>
        <item name="cornerRadius">28dp</item>
    </style>

    <style name="TellyButtonPrimary" parent="TellyButton">
        <item name="android:textColor">@color/black</item>
        <item name="backgroundTint">@color/tint_primary</item>
    </style>

    <style name="TellyButtonAccent" parent="TellyButton">
        <item name="android:textColor">@color/accent</item>
        <item name="backgroundTint">@color/tint_accent</item>
    </style>

    <style name="TellyButtonDanger" parent="TellyButton">
        <item name="android:textColor">@color/danger</item>
        <item name="backgroundTint">@color/tint_danger</item>
    </style>

    <!-- Section heading above a group of cards (Magisk style). -->
    <style name="SectionLabel">
        <item name="android:layout_gravity">start</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Permissions screen: compact cards that fit a 1080p TV. -->
    <style name="PermCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="PermCardBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="PermTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="PermDesc">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Status on the left, the settings button on the right of the same line. -->
    <style name="PermRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="PermStatus">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="PermButton" parent="TellyButtonAccent">
        <item name="android:layout_width">320dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Power LED screen: segmented mode switches and the brightness stepper. -->
    <style name="LedGroup">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <style name="LedModeButton" parent="TellyButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/mode_text</item>
        <item name="backgroundTint">@color/mode_bg</item>
    </style>

    <style name="LedLevelText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="LedStepButton" parent="TellyButton">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textSize">22sp</item>
    </style>

    <!-- Shown under a gated button group when its permission is missing. -->
    <style name="PermissionCaption">
        <item name="android:layout_gravity">start</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">@color/warning</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Side navigation item. -->
    <style name="RailItem" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">11sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/rail_text</item>
        <item name="backgroundTint">@color/rail_bg</item>
        <item name="icon">@null</item>
        <item name="iconGravity">textTop</item>
        <item name="iconSize">24dp</item>
        <item name="iconPadding">4dp</item>
        <item name="iconTint">@color/rail_text</item>
        <item name="cornerRadius">28dp</item>
    </style>

    <!-- Dialogs: dark panel, sentence-case buttons. -->
    <style name="TellyDialog" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="colorBackgroundFloating">@color/surface_alt</item>
        <item name="colorPrimary">@color/paper</item>
        <item name="buttonBarButtonStyle">@style/TellyDialogButton</item>
    </style>

    <style name="TellyDialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/paper</item>
    </style>
</resources>
